---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import MenuCategory from '../components/MenuCategory.astro';
import AiTeaserEasterEgg from '../components/AiTeaserEasterEgg.astro';
import OpenStatusBadge from '../components/OpenStatusBadge.astro';
import GoogleReviewsLink from '../components/GoogleReviewsLink.astro';
import Phone from '../components/icons/Phone.astro';
import MapPin from '../components/icons/MapPin.astro';
import Cart from '../components/Cart.astro';
import { business, openingHours } from '../lib/business';
import { buildCatalog } from '../lib/cart';

const categories = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);
const catalog = buildCatalog(categories.map((category) => ({ id: category.id, data: category.data })));
---

<BaseLayout
  title="en-cas 2 faim à Elven : pizzas, kebabs, burgers, tacos"
  description="Fast food en-cas 2 faim à Elven (56250) : pizzas, kebabs, burgers, tacos, quesadillas. Sur place ou à emporter, tous les jours."
>
  <a
    href="#menu"
    class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:m-2 focus:rounded focus:bg-white focus:px-4 focus:py-2 focus:text-ink-900 focus:outline-3"
  >
    Aller au menu
  </a>

  <header class="border-b-[3px] border-ink-900 bg-leaf px-4 py-12 text-center text-ink-900 sm:py-20">
    <p class="font-display text-sm font-bold uppercase tracking-[0.3em]">Elven · 56250</p>
    <h1 class="mt-3 font-display text-5xl font-black sm:text-6xl">
      en-cas
      <span class="mx-1 inline-block -rotate-3 rounded-lg border-[3px] border-ink-900 bg-white px-2 shadow-brut-sm">2</span>
      faim
    </h1>
    <p class="mx-auto mt-4 max-w-md text-lg font-medium">
      Pizzas maison, burgers façon bouchère, kebabs, tacos et quesadillas.
      Sur place ou à emporter.
    </p>

    <div class="hero-in mt-8 flex flex-wrap justify-center gap-3">
      <a
        href={`tel:${business.phoneHref}`}
        class="brut-btn inline-flex min-h-12 items-center gap-2 bg-ember-700 px-6 text-sm text-white"
      >
        <Phone class="h-4 w-4" /> Appeler {business.phoneDisplay}
      </a>
      <a
        href={business.mapsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="brut-btn inline-flex min-h-12 items-center gap-2 bg-cream px-6 text-sm text-ink-900 hover:bg-white"
      >
        <MapPin class="h-4 w-4" /> Itinéraire
      </a>
      <a
        href="#menu"
        class="brut-btn inline-flex min-h-12 items-center bg-cream px-6 text-sm text-ink-900 hover:bg-white"
      >
        Voir le menu
      </a>
    </div>

    <div class="flex flex-col items-center">
      <OpenStatusBadge />
      <GoogleReviewsLink />
    </div>

    <AiTeaserEasterEgg />
  </header>

  <main id="menu" class="mx-auto max-w-3xl px-4 py-12 sm:py-16">
    <h2 class="font-display text-4xl font-black text-ink-900">Notre carte</h2>

    <nav aria-label="Catégories du menu" class="mt-4 flex flex-wrap gap-2 text-sm">
      {
        categories.map((category) => (
          <a
            href={`#${category.id}`}
            class="inline-flex min-h-11 items-center rounded-lg border-2 border-ink-900 bg-white px-3 font-bold text-ink-900 hover:bg-leaf"
          >
            {category.data.title}
          </a>
        ))
      }
    </nav>

    <div class="mt-10 space-y-10">
      {categories.map((category) => <MenuCategory category={category.data} slug={category.id} {catalog} />)}
    </div>
  </main>

  <section class="border-t-[3px] border-ink-900 px-4 py-12 sm:py-16" aria-labelledby="infos-title">
    <div class="mx-auto max-w-3xl">
      <h2 id="infos-title" class="scroll-mt-24 font-display text-4xl font-black text-ink-900">Infos pratiques</h2>

      <div class="mt-6 grid gap-6 sm:grid-cols-2">
        <div class="brut-card bg-white p-5">
          <h3 class="font-display text-xl font-black text-brand-700">Horaires</h3>
          <dl class="mt-3 space-y-2 text-sm text-ink-900">
            {
              openingHours.map((slot) => (
                <div class="flex justify-between gap-4">
                  <dt class="font-bold">{slot.days}</dt>
                  <dd>{slot.ranges}</dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="brut-card bg-leaf p-5 text-ink-900">
          <h3 class="font-display text-xl font-black">Nous trouver</h3>
          <address class="mt-3 text-sm not-italic">
            {business.streetAddress}<br />
            {business.postalCode} {business.city}
          </address>
          <p class="mt-2 text-sm">
            <a href={`tel:${business.phoneHref}`} class="font-bold underline underline-offset-4">
              {business.phoneDisplay}
            </a>
          </p>
          <p class="mt-2 text-sm font-bold">Sur place ou à emporter</p>
        </div>
      </div>
    </div>
  </section>

  <footer class="border-t-[3px] border-ink-900 bg-ink-900 px-4 py-8 text-center text-sm text-cream">
    <p>en-cas 2 faim · {business.streetAddress}, {business.postalCode} {business.city} · {business.phoneDisplay}</p>
  </footer>

  <Cart {catalog} />
</BaseLayout>
