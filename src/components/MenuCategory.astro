---
import { formatPrice } from '../lib/format';
import type { MenuCategory } from '../lib/menu.schema';
import type { Catalog } from '../lib/cart';
import Plus from './icons/Plus.astro';

interface Props {
  category: MenuCategory;
  slug: string;
  catalog: Catalog;
}

const { category, slug, catalog } = Astro.props;

// Catalog key of each orderable item of this category, by position.
const keyByIndex = new Map(
  Object.values(catalog)
    .filter((entry) => entry.categoryId === slug)
    .map((entry) => [entry.itemIndex, entry.key]),
);

// One checkbox per extra label; the price may differ by size (pizzas).
const extraGroups = [...Map.groupBy(category.extras ?? [], (extra) => extra.label)].map(
  ([label, extras]) => {
    const sameAmount = extras.every((extra) => extra.amount === extras[0].amount);
    const priceText = sameAmount
      ? formatPrice(extras[0].amount)
      : extras.map((extra) => `${formatPrice(extra.amount)} (${extra.appliesTo})`).join(' · ');
    return { label, priceText };
  },
);
---

<section id={slug} class="brut-card scroll-mt-24 bg-white p-5">
  <h3
    class="inline-block -rotate-1 rounded-lg border-[3px] border-ink-900 bg-leaf px-3 py-1 font-display text-2xl font-black text-ink-900"
  >
    {category.title}
  </h3>
  {category.note && <p class="mt-3 text-sm text-ink-600">{category.note}</p>}

  <ul class="mt-4 divide-y-2 divide-ink-900/15">
    {
      category.items.map((item, index) => {
        const key = keyByIndex.get(index);
        return (
          <li class="flex flex-col gap-1 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
            <div class="sm:max-w-md">
              <p class="font-bold text-ink-900">
                {item.name}
                {item.tags?.map((tag) => (
                  <span class="ml-2 rounded-md border-2 border-ink-900 bg-cream px-2 py-0.5 text-xs font-bold text-ink-900">
                    {tag}
                  </span>
                ))}
              </p>
              {item.description && <p class="text-sm text-ink-600">{item.description}</p>}
              {key && extraGroups.length > 0 && (
                <details class="mt-1 text-sm" data-extras>
                  <summary class="inline-flex min-h-11 cursor-pointer items-center font-bold text-brand-700 underline underline-offset-4">
                    Un supplément&nbsp;?
                  </summary>
                  <div class="flex flex-col">
                    {extraGroups.map((group) => (
                      <label class="flex min-h-11 items-center gap-3 text-ink-900">
                        <input type="checkbox" value={group.label} data-extra class="h-5 w-5 accent-brand-600" />
                        <span>
                          {group.label} <span class="text-ink-600">{group.priceText}</span>
                        </span>
                      </label>
                    ))}
                  </div>
                </details>
              )}
            </div>
            {item.prices && item.prices.length > 0 && key && (
              <div class="flex shrink-0 flex-wrap gap-2 sm:justify-end">
                {item.prices.map((price) => (
                  <button
                    type="button"
                    data-add
                    data-item-key={key}
                    data-variant={price.label}
                    aria-label={`Ajouter ${item.name}${price.label ? `, ${price.label}` : ''}, ${formatPrice(price.amount)}`}
                    class="brut-btn inline-flex min-h-11 items-center gap-2 bg-cream px-3 text-sm text-ink-900 hover:bg-leaf"
                  >
                    {price.label && <span class="font-medium text-ink-600">{price.label}</span>}
                    <span class="font-black">{formatPrice(price.amount)}</span>
                    <Plus class="h-4 w-4" />
                  </button>
                ))}
              </div>
            )}
            {item.prices && item.prices.length > 0 && !key && (
              <div class="flex shrink-0 flex-wrap gap-x-4 gap-y-1 text-sm font-black text-ink-900 sm:justify-end">
                {item.prices.map((price) => (
                  <span>
                    {price.label && <span class="mr-1 font-medium text-ink-600">{price.label}</span>}
                    {formatPrice(price.amount)}
                  </span>
                ))}
              </div>
            )}
          </li>
        );
      })
    }
  </ul>

  {
    category.extras && category.extras.length > 0 && (
      <p class="mt-3 text-xs text-ink-600">
        {category.extras
          .map((extra) => `${extra.label}${extra.appliesTo ? ` (${extra.appliesTo})` : ''} : ${formatPrice(extra.amount)}`)
          .join(' · ')}
      </p>
    )
  }
</section>
